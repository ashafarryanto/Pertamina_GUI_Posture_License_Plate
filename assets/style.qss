/* ============ GLOBAL ============ */
QWidget {
    font-family: "Segoe UI", "Poppins", sans-serif;
    color: #1b1b1b;
}

#RootBackground {
    background-color: #ffffff;
}

/* ============ HEADER ============ */
#HeaderBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e2e2;
}
#HeaderTitle {
    font-size: 20px;
    font-weight: 700;
    color: #14213d;
}
#LogoBadge {
    background-color: #ffffff;
    border-radius: 8px;
}
#LogoTextPertamina {
    color: #ED1C24;
    font-weight: 800;
    font-size: 15px;
}
#LogoTextSub {
    color: #1E3C8C;
    font-size: 9px;
    font-weight: 600;
}

/* ============ CLOCK PANEL ============ */
#ClockPanel {
    background-color: #6b7684;
    border-radius: 10px;
}
#ClockLabelSmall {
    color: #e6e9ee;
    font-size: 11px;
}
#ClockTime {
    color: #ffffff;
    font-size: 26px;
    font-weight: 700;
}
#ClockDate {
    color: #d8dce2;
    font-size: 11px;
}

/* ============ CCTV PANEL ============ */
#CctvHeader {
    background-color: #C1272D;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}
#CctvTitle {
    color: #ffffff;
    font-weight: 700;
    font-size: 13px;
}
#LiveBadgeDot {
    background-color: #22c55e;
    border-radius: 4px;
}
#LiveBadgeText {
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
}
#CctvBody {
    background-color: #1a1a1a;
}
#CctvFooter {
    background-color: #C1272D;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}
#CctvFooterText {
    color: #ffffff;
    font-size: 11px;
}

/* ============ FORM / INPUT ============ */
#SectionLabel {
    font-size: 12px;
    font-weight: 700;
    color: #1b1b1b;
}
QLineEdit#PlateInput {
    border: 1px solid #c7c9cc;
    border-radius: 6px;
    padding: 10px;
    font-size: 14px;
    background: #ffffff;
}
QLineEdit#PlateInput:focus {
    border: 1.5px solid #1E3C8C;
}

/* ============ TAG LIST ============ */
QListWidget#TagList {
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    background: #ffffff;
}
QListWidget#TagList::item {
    border-bottom: 1px solid #f0f0f0;
    padding: 6px;
}
QListWidget#TagList::item:selected {
    background: #eef2fb;
}
#TagName {
    font-size: 12px;
    font-weight: 600;
}
#TagDate {
    font-size: 10px;
    color: #8a8f98;
}
#TagDuration {
    font-size: 10px;
    color: #8a8f98;
}

/* ============ BUTTONS ============ */
QPushButton#SecondaryBtn {
    background-color: #eef0f2;
    color: #3a3f47;
    border-radius: 6px;
    padding: 10px 18px;
    font-weight: 600;
}
QPushButton#SecondaryBtn:hover { background-color: #e1e4e8; }

QPushButton#PrimaryBtn {
    background-color: #1E3C8C;
    color: #ffffff;
    border-radius: 6px;
    padding: 10px 18px;
    font-weight: 600;
}
QPushButton#PrimaryBtn:hover { background-color: #16306f; }
QPushButton#PrimaryBtn:disabled { background-color: #a9b3cc; }

/* ============ VERIFICATION SCREEN ============ */
#VerifIconCircle {
    background-color: #eaf0fb;
    border-radius: 45px;
}
#VerifTitle {
    font-size: 22px;
    font-weight: 800;
    color: #14213d;
}
#VerifSubtitle {
    font-size: 12px;
    color: #6b7280;
}
